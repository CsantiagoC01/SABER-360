generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  PENDING
  GRADUATED
  WITHDRAWN
}

enum StaffType {
  TEACHING
  NON_TEACHING
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum GradeStatus {
  DRAFT
  PUBLISHED
}

enum AnnouncementAudience {
  EVERYONE
  STAFF
  TEACHERS
  STUDENTS
  GUARDIANS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACCESS
  EXPORT
}

model Institution {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  timezone     String        @default("UTC")
  countryCode  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  UserInstitution[]
  roles        Role[]
  students     Student[]
  guardians    Guardian[]
  staff        Staff[]
  departments  Department[]
  positions    Position[]
  academicYears AcademicYear[]
  subjects     Subject[]
  gradeLevels  GradeLevel[]
  classrooms   Classroom[]
  courses      Course[]
  enrollments  Enrollment[]
  attendance   Attendance[]
  grades       Grade[]
  announcements Announcement[]
  auditLogs    AuditLog[]

  @@index([name])
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  status          UserStatus        @default(INVITED)
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  memberships     UserInstitution[]
  studentProfile  Student?
  guardianProfile Guardian?
  staffProfile    Staff?
  auditLogs       AuditLog[]

  @@index([lastName, firstName])
}

model UserInstitution {
  id            String      @id @default(cuid())
  userId        String
  institutionId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  roles         UserRole[]

  @@unique([userId, institutionId])
  @@index([institutionId])
}

model Role {
  id            String              @id @default(cuid())
  institutionId String
  name          String
  key           String
  description   String?
  isSystem      Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  users         UserRole[]

  @@unique([institutionId, key])
  @@index([institutionId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  membershipId String
  roleId       String
  membership   UserInstitution @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model Student {
  id            String        @id @default(cuid())
  institutionId String
  userId        String?       @unique
  studentCode   String
  firstName     String
  lastName      String
  dateOfBirth   DateTime?     @db.Date
  email         String?
  phone         String?
  address       String?
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians     StudentGuardian[]
  enrollments   Enrollment[]
  attendance    Attendance[]
  grades        Grade[]

  @@unique([institutionId, studentCode])
  @@index([institutionId, lastName, firstName])
  @@index([institutionId, status])
}

model Guardian {
  id            String              @id @default(cuid())
  institutionId String
  userId        String?             @unique
  firstName     String
  lastName      String
  email         String?
  phone         String?
  relationship  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  students      StudentGuardian[]

  @@index([institutionId, lastName, firstName])
}

model StudentGuardian {
  studentId  String
  guardianId String
  isPrimary  Boolean  @default(false)
  canPickup  Boolean  @default(false)
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Department {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  staff         Staff[]

  @@unique([institutionId, name])
}

model Position {
  id            String      @id @default(cuid())
  institutionId String
  title         String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  staff         Staff[]

  @@unique([institutionId, title])
}

model Staff {
  id               String           @id @default(cuid())
  institutionId    String
  userId           String?          @unique
  departmentId     String?
  positionId       String?
  employeeCode     String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  staffType        StaffType        @default(NON_TEACHING)
  employmentStatus EmploymentStatus @default(ACTIVE)
  hiredAt          DateTime?        @db.Date
  endedAt          DateTime?        @db.Date
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  institution      Institution      @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position         Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  courseAssignments CourseTeacher[]

  @@unique([institutionId, employeeCode])
  @@index([institutionId, staffType, lastName])
  @@index([institutionId, employmentStatus])
}

model AcademicYear {
  id            String       @id @default(cuid())
  institutionId String
  name          String
  startsOn      DateTime     @db.Date
  endsOn        DateTime     @db.Date
  isCurrent     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  periods       AcademicPeriod[]
  courses       Course[]
  enrollments   Enrollment[]
  attendance    Attendance[]
  grades        Grade[]

  @@unique([institutionId, name])
  @@index([institutionId, isCurrent])
}

model AcademicPeriod {
  id            String      @id @default(cuid())
  academicYearId String
  name          String
  startsOn      DateTime    @db.Date
  endsOn        DateTime    @db.Date
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grades        Grade[]

  @@unique([academicYearId, name])
}

model GradeLevel {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  courses       Course[]

  @@unique([institutionId, name])
  @@index([institutionId, sortOrder])
}

model Subject {
  id            String      @id @default(cuid())
  institutionId String
  code          String?
  name          String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  courses       Course[]

  @@unique([institutionId, code])
  @@index([institutionId, name])
}

model Classroom {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  capacity      Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  courses       Course[]

  @@unique([institutionId, name])
}

model Course {
  id            String      @id @default(cuid())
  institutionId String
  academicYearId String
  gradeLevelId  String
  subjectId     String?
  classroomId   String?
  name          String
  section       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeLevel    GradeLevel  @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  subject       Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classroom     Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  teachers      CourseTeacher[]
  enrollments   Enrollment[]
  attendance    Attendance[]
  grades        Grade[]

  @@unique([institutionId, academicYearId, name, section])
  @@index([institutionId, academicYearId, gradeLevelId])
}

model CourseTeacher {
  courseId String
  staffId  String
  assignedAt DateTime @default(now())
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([courseId, staffId])
  @@index([staffId])
}

model Enrollment {
  id            String           @id @default(cuid())
  institutionId String
  studentId     String
  courseId      String
  academicYearId String
  status        EnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime         @default(now())
  endedAt       DateTime?
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicYear  AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([institutionId, academicYearId, status])
}

model Attendance {
  id            String           @id @default(cuid())
  institutionId String
  studentId     String
  courseId      String
  academicYearId String
  date          DateTime         @db.Date
  status        AttendanceStatus
  note          String?
  recordedAt    DateTime         @default(now())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicYear  AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId, date])
  @@index([institutionId, date, courseId])
}

model Grade {
  id              String      @id @default(cuid())
  institutionId   String
  studentId       String
  courseId        String
  academicYearId  String
  academicPeriodId String
  title           String
  score           Decimal     @db.Decimal(7, 2)
  maxScore        Decimal     @default(100) @db.Decimal(7, 2)
  status          GradeStatus @default(DRAFT)
  gradedAt        DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  student         Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course          Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  academicPeriod  AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  @@index([institutionId, studentId, academicPeriodId])
  @@index([courseId, academicPeriodId])
}

model Announcement {
  id            String              @id @default(cuid())
  institutionId String
  title         String
  body          String
  audience      AnnouncementAudience @default(EVERYONE)
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId, publishedAt])
}

model AuditLog {
  id            String      @id @default(cuid())
  institutionId String
  userId        String?
  action        AuditAction
  entity        String
  entityId      String?
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
}
