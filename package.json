{
  "name": "saber-360",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @saber360/web",
    "dev:web": "npm run dev --workspace @saber360/web",
    "dev:api": "npm run dev --workspace @saber360/api",
    "build": "npm run build --workspace @saber360/web && npm run build --workspace @saber360/api",
    "build:web": "npm run build --workspace @saber360/web",
    "build:api": "npm run build --workspace @saber360/api",
    "db:generate": "npm run db:generate --workspace @saber360/api",
    "db:migrate": "npm run db:migrate --workspace @saber360/api",
    "db:seed": "npm run db:seed --workspace @saber360/api",
    "db:studio": "npm run db:studio --workspace @saber360/api"
  }
}
